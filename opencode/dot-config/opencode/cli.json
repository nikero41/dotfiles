{
	"$schema": "https://opencode.ai/v2/cli.json",
	"theme": {
		"name": "catppuccin"
	},
	"scroll": {
		"acceleration": true
	},
	"keybinds": {
		"agent.cycle": "tab",
		"agent.cycle.reverse": "shift+tab",
		"session.child.next": "ctrl+alt+l",
		"session.child.previous": "ctrl+alt+h"
	},
	"attention": {
		"notifications": true,
		"sound": true
	},
	"animations": true,
	"session": {
		"scrollbar": true,
		"markdown": "rendered",
		"grouping": "auto",
		"image_preview": true,
		"tps": true,
		"permissions": "prompt"
	},
	"tabs": {
		"mode": "auto",
		"layout": "horizontal",
		"indicators": "status"
	},
	"diffs": {
		"view": "auto"
	}
}
