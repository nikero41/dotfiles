{
	"$schema": "https://opencode.ai/v2/cli.json",
	"theme": { "name": "catppuccin" },
	"scroll": { "acceleration": true },
	"keybinds": {
		"agent.cycle": "tab",
		"agent.cycle.reverse": "shift+tab",
		"session.child.next": "ctrl+alt+l",
		"session.child.previous": "ctrl+alt+h"
	},
	"attention": {
		"notifications": true,
		"sound": true,
		"volume": 0.4
	},
	"animations": true,
	"session": {
		"scrollbar": true,
		"markdown": "rendered",
		"grouping": "auto",
		"image_preview": true,
		"tps": true,
		"permissions": "prompt",
		"sidebar": "auto"
	},
	"tabs": {
		"mode": "on",
		"layout": "horizontal",
		"indicators": "status",
		"scope": "cwd"
	},
	"diffs": {
		"view": "auto",
		"wrap": "word",
		"tree": true,
		"single": false
	},
	"prompt": { "paste": "compact" },
	"leader": { "timeout": 3000 },
	"terminal": { "title": true, "copy": "select" }
}
