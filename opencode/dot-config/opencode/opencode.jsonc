{
	"$schema": "https://opencode.ai/config.json",
	"share": "manual",
	"tools": {},
	"default_agent": "plan",
	"instructions": ["TODO_POLICY.md"],
	"lsp": true,
	"permission": {
		"read": {
			"*": "allow",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			".env.sample": "allow",
			".env.example": "allow",
			"**/.env.sample": "allow",
			"**/.env.example": "allow",
		},
		"glob": {
			"*": "allow",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			".env.sample": "allow",
			".env.example": "allow",
			"**/.env.sample": "allow",
			"**/.env.example": "allow",
		},
		"edit": {
			"*": "ask",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
		},
		"todowrite": "allow",
		"bash": {
			"*": "allow",
			"git push": "deny",
			"npm *": "ask",
			"npm run fmt": "allow",
			"npm run lint": "allow",
			"npm run lint:*": "allow",
			"npm ls": "allow",
			"npm ls *": "allow",
			"npm list": "allow",
			"npm list *": "allow",
			"npm outdated": "allow",
			"npm outdated *": "allow",
			"npm view *": "allow",
			"npm info *": "allow",
			"npm explain *": "allow",
			"npm audit": "allow",
			"npm audit *": "allow",
			"pnpm fmt": "allow",
			"pnpm lint": "allow",
			"pnpm lint:*": "allow",
			"pnpm ls": "allow",
			"pnpm ls *": "allow",
			"pnpm list": "allow",
			"pnpm list *": "allow",
			"pnpm outdated": "allow",
			"pnpm outdated *": "allow",
			"pnpm view *": "allow",
			"pnpm why *": "allow",
			"pnpm audit": "allow",
			"pnpm audit *": "allow",
			"yarn fmt": "allow",
			"yarn lint": "allow",
			"yarn lint:*": "allow",
			"yarn list": "allow",
			"yarn list *": "allow",
			"yarn outdated": "allow",
			"yarn outdated *": "allow",
			"yarn info *": "allow",
			"yarn why *": "allow",
			"bun fmt": "allow",
			"bun lint": "allow",
			"bun lint:*": "allow",
			"bun pm ls": "allow",
			"bun pm ls *": "allow",
			"bun outdated": "allow",
			"bun outdated *": "allow",
			"bun info *": "allow",
			"cargo check": "allow",
			"cargo clippy": "allow",
			"cargo fmt --check": "allow",
			"go vet": "allow",
			"go fmt": "allow",
			"golangci-lint run": "allow",
			"golangci-lint run *": "allow",
			"rm -rf": "deny",
		},
	},
}
