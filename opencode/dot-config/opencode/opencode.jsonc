{
	"$schema": "https://opencode.ai/config.json",
	"share": "manual",
	"tools": {},
	"default_agent": "plan",
	"instructions": ["TODO_POLICY.md"],
	"lsp": true,
	"permission": {
		"read": {
			"*": "allow",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			".env.sample": "allow",
			".env.example": "allow",
			"**/.env.sample": "allow",
			"**/.env.example": "allow",
		},
		"glob": {
			"*": "allow",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			".env.sample": "allow",
			".env.example": "allow",
			"**/.env.sample": "allow",
			"**/.env.example": "allow",
		},
		"edit": {
			"*": "ask",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
		},
		"todowrite": "allow",
		"bash": {
			"*": "allow",
			"git push": "deny",
			"npm *": "ask",
			"rm -rf": "deny",
		},
	},
}
