{
	"$schema": "https://opencode.ai/config.json",
	"share": "manual",
	"tools": {},
	"default_agent": "plan",
	"instructions": ["TODO_POLICY.md"],
	"lsp": true,
	"permission": {
		"read": {
			"*": "allow",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			".env.sample": "allow",
			".env.example": "allow",
			"**/.env.sample": "allow",
			"**/.env.example": "allow",
		},
		"glob": {
			"*": "allow",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			".env.sample": "allow",
			".env.example": "allow",
			"**/.env.sample": "allow",
			"**/.env.example": "allow",
		},
		"edit": {
			"*": "ask",
			".env": "deny",
			".env.*": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
		},
		"todowrite": "allow",
		"bash": {
			"*": "allow",
			"git push": "deny",
			"npm *": "ask",
			"npm run fmt": "allow",
			"npm run lint": "allow",
			"npm run lint:*": "allow",
			"pnpm fmt": "allow",
			"pnpm lint": "allow",
			"pnpm lint:*": "allow",
			"yarn fmt": "allow",
			"yarn lint": "allow",
			"yarn lint:*": "allow",
			"bun fmt": "allow",
			"bun lint": "allow",
			"bun lint:*": "allow",
			"cargo check": "allow",
			"cargo clippy": "allow",
			"cargo fmt --check": "allow",
			"go vet": "allow",
			"go fmt": "allow",
			"golangci-lint run": "allow",
			"golangci-lint run *": "allow",
			"rm -rf": "deny",
		},
	},
}
