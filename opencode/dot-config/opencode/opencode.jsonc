{
	"$schema": "https://opencode.ai/config.json",
	"share": "manual",
	"default_agent": "plan",
	"formatter": true,
	"lsp": true,
	"permissions": [
		{ "action": "read", "resource": "*", "effect": "allow" },
		{ "action": "read", "resource": ".env", "effect": "deny" },
		{ "action": "read", "resource": ".env.*", "effect": "deny" },
		{ "action": "read", "resource": "**/.env", "effect": "deny" },
		{ "action": "read", "resource": "**/.env.*", "effect": "deny" },
		{ "action": "read", "resource": ".env.sample", "effect": "allow" },
		{ "action": "read", "resource": ".env.example", "effect": "allow" },
		{ "action": "read", "resource": "**/.env.sample", "effect": "allow" },
		{ "action": "read", "resource": "**/.env.example", "effect": "allow" },
		{ "action": "glob", "resource": "*", "effect": "allow" },
		{ "action": "glob", "resource": ".env", "effect": "deny" },
		{ "action": "glob", "resource": ".env.*", "effect": "deny" },
		{ "action": "glob", "resource": "**/.env", "effect": "deny" },
		{ "action": "glob", "resource": "**/.env.*", "effect": "deny" },
		{ "action": "glob", "resource": ".env.sample", "effect": "allow" },
		{ "action": "glob", "resource": ".env.example", "effect": "allow" },
		{ "action": "glob", "resource": "**/.env.sample", "effect": "allow" },
		{ "action": "glob", "resource": "**/.env.example", "effect": "allow" },
		{ "action": "edit", "resource": "*", "effect": "ask" },
		{ "action": "edit", "resource": ".env", "effect": "deny" },
		{ "action": "edit", "resource": ".env.*", "effect": "deny" },
		{ "action": "edit", "resource": "**/.env", "effect": "deny" },
		{ "action": "edit", "resource": "**/.env.*", "effect": "deny" },
		{ "action": "todowrite", "resource": "*", "effect": "allow" },
		{ "action": "shell", "resource": "*", "effect": "allow" },
		{ "action": "shell", "resource": "git push", "effect": "deny" },
		{ "action": "shell", "resource": "npm *", "effect": "ask" },
		{ "action": "shell", "resource": "npm run fmt", "effect": "allow" },
		{ "action": "shell", "resource": "npm run lint", "effect": "allow" },
		{ "action": "shell", "resource": "npm run lint:*", "effect": "allow" },
		{ "action": "shell", "resource": "npm ls", "effect": "allow" },
		{ "action": "shell", "resource": "npm ls *", "effect": "allow" },
		{ "action": "shell", "resource": "npm list", "effect": "allow" },
		{ "action": "shell", "resource": "npm list *", "effect": "allow" },
		{ "action": "shell", "resource": "npm outdated", "effect": "allow" },
		{ "action": "shell", "resource": "npm outdated *", "effect": "allow" },
		{ "action": "shell", "resource": "npm view *", "effect": "allow" },
		{ "action": "shell", "resource": "npm info *", "effect": "allow" },
		{ "action": "shell", "resource": "npm explain *", "effect": "allow" },
		{ "action": "shell", "resource": "npm audit", "effect": "allow" },
		{ "action": "shell", "resource": "npm audit *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm fmt", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm lint", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm lint:*", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm ls", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm ls *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm list", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm list *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm outdated", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm outdated *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm view *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm why *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm audit", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm audit *", "effect": "allow" },
		{ "action": "shell", "resource": "yarn fmt", "effect": "allow" },
		{ "action": "shell", "resource": "yarn lint", "effect": "allow" },
		{ "action": "shell", "resource": "yarn lint:*", "effect": "allow" },
		{ "action": "shell", "resource": "yarn list", "effect": "allow" },
		{ "action": "shell", "resource": "yarn list *", "effect": "allow" },
		{ "action": "shell", "resource": "yarn outdated", "effect": "allow" },
		{ "action": "shell", "resource": "yarn outdated *", "effect": "allow" },
		{ "action": "shell", "resource": "yarn info *", "effect": "allow" },
		{ "action": "shell", "resource": "yarn why *", "effect": "allow" },
		{ "action": "shell", "resource": "bun fmt", "effect": "allow" },
		{ "action": "shell", "resource": "bun lint", "effect": "allow" },
		{ "action": "shell", "resource": "bun lint:*", "effect": "allow" },
		{ "action": "shell", "resource": "bun pm ls", "effect": "allow" },
		{ "action": "shell", "resource": "bun pm ls *", "effect": "allow" },
		{ "action": "shell", "resource": "bun outdated", "effect": "allow" },
		{ "action": "shell", "resource": "bun outdated *", "effect": "allow" },
		{ "action": "shell", "resource": "bun info *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo check", "effect": "allow" },
		{ "action": "shell", "resource": "cargo clippy", "effect": "allow" },
		{ "action": "shell", "resource": "cargo fmt --check", "effect": "allow" },
		{ "action": "shell", "resource": "go vet", "effect": "allow" },
		{ "action": "shell", "resource": "go fmt", "effect": "allow" },
		{ "action": "shell", "resource": "golangci-lint run", "effect": "allow" },
		{ "action": "shell", "resource": "golangci-lint run *", "effect": "allow" },
		{ "action": "shell", "resource": "rm -rf", "effect": "deny" },
  ],
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    "@slkiser/opencode-quota@latest"
  ],
  "plugins": [
    "opencode-skills-tui"
  ],
}
