shell-integration-features = "no-cursor,sudo"
bell-features = title,system,attention,border,audio

# Font
font-family = "JetBrainsMono Nerd Font Med"
font-size = 13
adjust-cell-height = 7
font-thicken = true
adjust-underline-position = 5
adjust-underline-thickness = 1

# Theme
theme = "catppuccin-mocha.conf"
alpha-blending = "linear-corrected"

# Window
window-padding-color = "background"
window-padding-balance = true
window-padding-y = 2,4
window-colorspace = "display-p3"

# Quick Terminal
quick-terminal-position = "center"
keybind = global:cmd+alt+t=toggle_quick_terminal

# Mouse
mouse-scroll-multiplier = 2
mouse-hide-while-typing = true

# macOS
macos-option-as-alt = true
macos-titlebar-style = "hidden"

# Cursor
cursor-style-blink = false
# custom-shader = "shaders/cursor_blaze.glsl"
# custom-shader = "shaders/cursor_blaze_no_trail.glsl"
# custom-shader = "shaders/cursor_blaze_tapered.glsl"
# custom-shader = "shaders/cursor_frozen.glsl"

# Keybinding
keybind = cmd+s>shift+r=reload_config
keybind = cmd+s>x=close_surface
keybind = alt+left=unbind
keybind = alt+right=unbind

# Tabs
keybind = cmd+s>c=new_tab
keybind = cmd+s>n=next_tab
keybind = cmd+s>p=previous_tab
keybind = cmd+s>shift+,=move_tab:-1
keybind = cmd+s>shift+.=move_tab:1

# Quick tab switch
keybind = cmd+s>1=goto_tab:1
keybind = cmd+s>2=goto_tab:2
keybind = cmd+s>3=goto_tab:3
keybind = cmd+s>4=goto_tab:4
keybind = cmd+s>5=goto_tab:5
keybind = cmd+s>6=goto_tab:6
keybind = cmd+s>7=goto_tab:7
keybind = cmd+s>8=goto_tab:8
keybind = cmd+s>9=goto_tab:9

# Split
keybind = cmd+s>s=new_split:right
keybind = cmd+s>v=new_split:down

# Split navigation
keybind = cmd+s>j=goto_split:bottom
keybind = cmd+s>k=goto_split:top
keybind = cmd+s>h=goto_split:left
keybind = cmd+s>l=goto_split:right

keybind = cmd+s>z=toggle_split_zoom

keybind = cmd+s>e=equalize_splits
