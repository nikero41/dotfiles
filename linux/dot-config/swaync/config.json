{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-exclusive-zone": true,
  "control-center-margin-top": 12,
  "control-center-margin-right": 12,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "notification-window-width": 380,
  "control-center-width": 380,
  "fit-to-screen": false,
  "control-center-height": -1,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "All clear",
  "notification-visibility": {
    "zen-browser": {
      "state": "muted",
      "app-name": "(?i)zen"
    }
  },
  "widgets": ["title", "mpris", "volume", "backlight", "buttons-grid", "dnd", "notifications"],
  "widget-config": {
    "notifications": {
      "vexpand": false
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "blacklist": [],
      "loop-carousel": false
    },
    "volume": {
      "label": "Volume",
      "show-per-app": false
    },
    "backlight": {
      "label": "Brightness",
      "device": "intel_backlight",
      "subsystem": "backlight",
      "min": 5
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "Wi-Fi",
          "type": "toggle",
          "command": "[ $SWAYNC_TOGGLE_STATE = true ] && nmcli radio wifi on || nmcli radio wifi off",
          "update-command": "nmcli radio wifi | grep -qx enabled && echo true || echo false"
        },
        {
          "label": "Bluetooth",
          "type": "toggle",
          "command": "[ $SWAYNC_TOGGLE_STATE = true ] && bluetoothctl power on || bluetoothctl power off",
          "update-command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
        }
      ]
    }
  }
}
